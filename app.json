{
  "expo": {
    "name": "Agenda Taller",
    "slug": "agenda-taller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d63a5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agendataller.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d63a5"
      },
      "package": "com.agendataller.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": true
  }
}
